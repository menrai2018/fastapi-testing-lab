{
"info": {
"name": "API-Testing-Lab",
"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
},
"event": [
{
"listen": "prerequest",
"script": {
"type": "text/javascript",
"exec": [
"if (!pm.collectionVariables.get('token')) {",
"    pm.sendRequest({",
"        url: pm.variables.get('baseUrl') + '/api/auth/login',",
"        method: 'POST',",
"        header: { 'Content-Type': 'application/json' },",
"        body: {",
"            mode: 'raw',",
"            raw: JSON.stringify({",
"                username: pm.variables.get('username'),",
"                password: pm.variables.get('password')",
"            })",
"        }",
"    }, (err, res) => {",
"        if (err || res.code !== 200) {",
"            console.error('Auto-login failed', err || res.code);",
"            return;",
"        }",
"        pm.collectionVariables.set('token', res.json().token);",
"    });",
"}"
]
}
}
],
"variable": [
{ "key": "token", "value": "" },
{ "key": "productId", "value": "" },
{ "key": "productName", "value": "" },
{
"key": "productSchema",
"value": "{\"type\":\"object\",\"required\":[\"id\",\"name\",\"price\",\"stock\",\"discountPercent\",\"finalPrice\"],\"properties\":{\"id\":{\"type\":\"integer\",\"minimum\":1},\"name\":{\"type\":\"string\",\"minLength\":1},\"price\":{\"type\":\"number\",\"exclusiveMinimum\":0},\"stock\":{\"type\":\"integer\",\"minimum\":0},\"discountPercent\":{\"type\":\"number\",\"minimum\":0,\"maximum\":100},\"finalPrice\":{\"type\":\"number\",\"minimum\":0}}}"
}
],
"item": [
{
"name": "01-Unit-API-Tests",
"item": [
{
"name": "Health Check",
"request": {
"method": "GET",
"header": [],
"url": "{{baseUrl}}/health"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('Status code ต้องเป็น 200', () => { pm.response.to.have.status(200); });",
"pm.test('Response time ต้องน้อยกว่า 500ms', () => { pm.expect(pm.response.responseTime).to.be.below(500); });",
"pm.test('Content-Type ต้องเป็น JSON', () => { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/json'); });",
"pm.test('Body ต้องมี status = \"ok\"', () => { pm.expect(pm.response.json().status).to.eql('ok'); });"
]
}
}]
},
{
"name": "Login Success",
"request": {
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
"url": "{{baseUrl}}/api/auth/login"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('Status code ต้องเป็น 200', () => { pm.response.to.have.status(200); });",
"const body = pm.response.json();",
"pm.test('ต้องได้ token เป็น string ที่ไม่ว่าง และเป็นชนิด Bearer', () => {",
"    pm.expect(body.token).to.be.a('string').and.not.empty;",
"    pm.expect(body.tokenType).to.eql('Bearer');",
"});",
"pm.collectionVariables.set('token', body.token);"
]
}
}]
},
{
"name": "Login Wrong Password",
"request": {
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"wrong-password\"\n}" },
"url": "{{baseUrl}}/api/auth/login"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('Status code ต้องเป็น 401', () => { pm.response.to.have.status(401); });",
"pm.test('ต้องแจ้งข้อความ error ที่ถูกต้อง', () => { pm.expect(pm.response.json().error).to.eql('Invalid username or password'); });",
"pm.test('ต้องไม่มี token ส่งกลับมา', () => { pm.expect(pm.response.json()).to.not.have.property('token'); });"
]
}
}]
},
{
"name": "Get Products",
"request": {
"method": "GET",
"header": [],
"url": "{{baseUrl}}/api/products"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"const productSchema = JSON.parse(pm.collectionVariables.get('productSchema'));",
"pm.test('Status code ต้องเป็น 200', () => { pm.response.to.have.status(200); });",
"pm.test('Body ต้องเป็น array ที่มีข้อมูล', () => { pm.expect(pm.response.json()).to.be.an('array').that.is.not.empty; });",
"pm.test('ทุกรายการต้องตรงกับ JSON Schema', () => { pm.response.to.have.jsonSchema({ type: 'array', items: productSchema }); });",
"pm.test('finalPrice ต้องคำนวณถูกต้องทุกรายการ', () => {",
"    pm.response.json().forEach((p) => {",
"        const expected = Math.round(p.price * (100 - p.discountPercent)) / 100;",
"        pm.expect(p.finalPrice, `สินค้า id ${p.id}`).to.eql(expected);",
"    });",
"});"
]
}
}]
},
{
"name": "Get Product Not Found",
"request": {
"method": "GET",
"header": [],
"url": "{{baseUrl}}/api/products/999999"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('Status code ต้องเป็น 404', () => { pm.response.to.have.status(404); });",
"pm.test('ข้อความ error ต้องระบุ id ที่หาไม่พบ', () => { pm.expect(pm.response.json().error).to.include('999999'); });"
]
}
}]
},
{
"name": "Get Product - Invalid Id",
"request": {
"method": "GET",
"header": [],
"url": "{{baseUrl}}/api/products/abc"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('id ที่ไม่ใช่ตัวเลข ต้องได้ 400', () => {",
"    pm.response.to.have.status(400);",
"    pm.expect(pm.response.json().error).to.eql('id must be a positive integer');",
"});"
]
}
}]
},
{
"name": "Create Product - No Token",
"request": {
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"name\": \"Monitor\",\n  \"price\": 5990,\n  \"stock\": 3\n}" },
"url": "{{baseUrl}}/api/products"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('ไม่ส่ง token ต้องถูกปฏิเสธด้วย 401', () => {",
"    pm.response.to.have.status(401);",
"    pm.expect(pm.response.json().error).to.eql('Unauthorized');",
"});"
]
}
}]
},
{
"name": "Create Product - Invalid Body",
"request": {
"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"name\": \"\",\n  \"price\": -10,\n  \"stock\": 1.5,\n  \"discountPercent\": 150\n}" },
"url": "{{baseUrl}}/api/products"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('Status code ต้องเป็น 400', () => { pm.response.to.have.status(400); });",
"pm.test('details ต้องบอกข้อผิดพลาดครบทั้ง 4 ฟิลด์', () => {",
"    const { details } = pm.response.json();",
"    pm.expect(details).to.have.members([",
"        'name is required',",
"        'price must be a number greater than 0',",
"        'stock must be an integer >= 0',",
"        'discountPercent must be between 0 and 100'",
"    ]);",
"});"
]
}
}]
}
]
},
{
"name": "02-Integration-Flow",
"item": [
{
"name": "S1 Login",
"request": {
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}" },
"url": "{{baseUrl}}/api/auth/login"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('[S1] Login สำเร็จ', () => { pm.response.to.have.status(200); });",
"pm.collectionVariables.set('token', pm.response.json().token);",
"pm.collectionVariables.unset('productId');"
]
}
}]
},
{
"name": "S2 Create Product",
"request": {
"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"name\": \"{{productName}}\",\n  \"price\": 5990,\n  \"stock\": 3,\n  \"discountPercent\": 15\n}" },
"url": "{{baseUrl}}/api/products"
},
"event": [
{
"listen": "prerequest",
"script": {
"type": "text/javascript",
"exec": [
"const uniqueName = `Integration Monitor ${Date.now()}`;",
"pm.collectionVariables.set('productName', uniqueName);"
]
}
},
{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('[S2] สร้างสินค้าได้ (201)', () => { pm.response.to.have.status(201); });",
"const body = pm.response.json();",
"pm.test('[S2] Response ตรงกับ JSON Schema', () => {",
"    const schema = JSON.parse(pm.collectionVariables.get('productSchema'));",
"    pm.response.to.have.jsonSchema(schema);",
"});",
"pm.test('[S2] ข้อมูลตรงกับที่ส่ง และ finalPrice ถูกต้อง', () => {",
"    pm.expect(body.name).to.eql(pm.collectionVariables.get('productName'));",
"    pm.expect(body.price).to.eql(5990);",
"    pm.expect(body.finalPrice).to.eql(5091.5);",
"});",
"pm.collectionVariables.set('productId', body.id);"
]
}
}
]
},
{
"name": "S3 Get Product By Id",
"request": {
"method": "GET",
"header": [],
"url": "{{baseUrl}}/api/products/{{productId}}"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('[S3] อ่านสินค้าที่เพิ่งสร้างได้ (200)', () => { pm.response.to.have.status(200); });",
"pm.test('[S3] ข้อมูลที่อ่านได้ตรงกับที่บันทึกไว้', () => {",
"    const body = pm.response.json();",
"    pm.expect(body.id).to.eql(Number(pm.collectionVariables.get('productId')));",
"    pm.expect(body.name).to.eql(pm.collectionVariables.get('productName'));",
"});"
]
}
}]
},
{
"name": "S4 Update Product",
"request": {
"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
"method": "PUT",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"stock\": 10,\n  \"discountPercent\": 0\n}" },
"url": "{{baseUrl}}/api/products/{{productId}}"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('[S4] แก้ไขสินค้าได้ (200)', () => { pm.response.to.have.status(200); });",
"pm.test('[S4] stock และ finalPrice ถูกอัปเดต', () => {",
"    const body = pm.response.json();",
"    pm.expect(body.stock).to.eql(10);",
"    pm.expect(body.finalPrice).to.eql(5990);",
"    pm.expect(body).to.have.property('updatedAt');",
"});"
]
}
}]
},
{
"name": "S5 Verify In List",
"request": {
"method": "GET",
"header": [],
"url": "{{baseUrl}}/api/products"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('[S5] สินค้าต้องอยู่ในรายการด้วยค่าล่าสุด', () => {",
"    const id = Number(pm.collectionVariables.get('productId'));",
"    const item = pm.response.json().find((p) => p.id === id);",
"    pm.expect(item, 'ไม่พบสินค้าในรายการ').to.exist;",
"    pm.expect(item.stock).to.eql(10);",
"});"
]
}
}]
},
{
"name": "S6 Delete Product",
"request": {
"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
"method": "DELETE",
"header": [],
"url": "{{baseUrl}}/api/products/{{productId}}"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('[S6] ลบสินค้าได้ (204)', () => { pm.response.to.have.status(204); });",
"pm.test('[S6] ต้องไม่มี body ตอบกลับ', () => { pm.expect(pm.response.text()).to.be.empty; });"
]
}
}]
},
{
"name": "S7 Verify Deleted",
"request": {
"method": "GET",
"header": [],
"url": "{{baseUrl}}/api/products/{{productId}}"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"pm.test('[S7] สินค้าที่ลบแล้วต้องหาไม่พบ (404)', () => { pm.response.to.have.status(404); });",
"pm.collectionVariables.unset('productId');",
"pm.collectionVariables.unset('productName');"
]
}
}]
}
]
},
{
"name": "03-Data-Driven",
"item": [
{
"name": "Create Product (Data-Driven)",
"request": {
"auth": { "type": "bearer", "bearer": [{ "key": "token", "value": "{{token}}", "type": "string" }] },
"method": "POST",
"header": [{ "key": "Content-Type", "value": "application/json" }],
"body": { "mode": "raw", "raw": "{\n  \"name\": \"{{name}}\",\n  \"price\": {{price}},\n  \"stock\": {{stock}},\n  \"discountPercent\": {{discountPercent}}\n}" },
"url": "{{baseUrl}}/api/products"
},
"event": [{
"listen": "test",
"script": {
"type": "text/javascript",
"exec": [
"const label = pm.iterationData.get('caseName');",
"const expectedStatus = Number(pm.iterationData.get('expectedStatus'));",
"pm.test(`[${label}] status ต้องเป็น ${expectedStatus}`, () => { pm.response.to.have.status(expectedStatus); });",
"if (expectedStatus === 201) {",
"    const body = pm.response.json();",
"    const expectedFinalPrice = Number(pm.iterationData.get('expectedFinalPrice'));",
"    pm.test(`[${label}] finalPrice ต้องเป็น ${expectedFinalPrice}`, () => { pm.expect(body.finalPrice).to.eql(expectedFinalPrice); });",
"    pm.sendRequest({",
"        url: `${pm.variables.get('baseUrl')}/api/products/${body.id}`,",
"        method: 'DELETE',",
"        header: { Authorization: `Bearer ${pm.collectionVariables.get('token')}` }",
"    });",
"} else {",
"    pm.test(`[${label}] ต้องมี details อธิบายข้อผิดพลาด`, () => {",
"        const details = pm.response.json().details;",
"        pm.expect(details).to.be.an('array').that.is.not.empty;",
"    });",
"}"
]
}
}]
}
]
}
]
}
